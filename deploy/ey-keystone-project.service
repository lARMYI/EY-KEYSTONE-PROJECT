[Unit]
Description=EY Keystone Project secure web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/EY-KEYSTONE-PROJECT
EnvironmentFile=/home/ubuntu/EY-KEYSTONE-PROJECT/.env
ExecStart=/usr/bin/python3 /home/ubuntu/EY-KEYSTONE-PROJECT/server.py
Restart=always
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadWritePaths=/home/ubuntu/EY-KEYSTONE-PROJECT/data

[Install]
WantedBy=multi-user.target
