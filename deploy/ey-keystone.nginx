server {
    listen 80;
    listen [::]:80;
    server_name ey.keystone.makeitpersonal.ai;

    server_tokens off;
    client_max_body_size 256k;

    location ~* (^|/)(\.|data(?:/|$)|keystone_backend(?:/|$)|__pycache__(?:/|$)) {
        return 404;
    }

    location ~* (^|/)(server\.py|AGENTS\.md|_headers|keystone_access_codes\.txt)$ {
        return 404;
    }

    location = /api/access {
        limit_req zone=keystone_access burst=6 nodelay;
        proxy_pass http://127.0.0.1:8081;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location = /api/claude {
        limit_req zone=keystone_claude burst=12 nodelay;
        proxy_pass http://127.0.0.1:8081;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
